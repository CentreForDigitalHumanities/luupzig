  "license": "BSD-3-Clause",
  "scripts": {
    "ng": "ng",
    "start": "yarn build library && ng serve frontend",
    "build": "ng build",
    "build:elements": "yarn build library && ng build --project elements --output-hashing none && yarn pack:elements && cp elements/package.json dist/elements",
    "pack:elements": "cat ./dist/elements/*.js > dist/elements/elements.js && ls -lah dist/elements/elements.js",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/elements": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-browser-dynamic": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~6.6.0",
    "tslib": "^2.1.0",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@types/jasmine": "~3.6.0",
    "@types/node": "^26.6.2",
    "bulma": "^1.0.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "^5.1.2",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.0.3",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "^1.5.0",
    "ng-packagr": "^22.2.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}